{
    "name": "@propagande-studio/utils",
    "version": "0.0.4",
    "description": "PROPAGANDE utils.",
    "author": "propagande.studio",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/propagande-studio/utils.git"
    },
    "type": "module",
    "scripts": {
        "build": "bun ./build && bun run types",
        "build:watch": "concurrently --kill-others \"bun ./build.watch\" \"bun run types --watch --preserveWatchOutput\"",
        "types": "tsc packages/{shared,vue}/index.ts --skipLibCheck true --declaration --emitDeclarationOnly --outDir dist"
    },
    "sideEffects": false,
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@types/bun": "latest",
        "concurrently": "^9.1.2"
    },
    "peerDependencies": {
        "typescript": "^5",
        "vue": "^3",
        "gsap": "^3.12"
    },
    "peerDependenciesMeta": {
        "vue": {
            "optional": true
        }
    },
    "files": [
        "dist"
    ],
    "main": "./dist/shared-index.js",
    "module": "./dist/shared-index.js",
    "types": "./dist/shared/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/shared/index.d.ts",
            "import": "./dist/shared-index.js",
            "default": "./dist/shared-index.js"
        },
        "./shared": {
            "types": "./dist/shared/index.d.ts",
            "import": "./dist/shared-index.js",
            "default": "./dist/shared-index.js"
        },
        "./vue": {
            "types": "./dist/vue/index.d.ts",
            "import": "./dist/vue-index.js",
            "default": "./dist/vue-index.js"
        }
    }
}
