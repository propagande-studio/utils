{
    "name": "@propagande/utils",
    "version": "0.0.42",
    "description": "PROPAGANDE utils.",
    "packageManager": "bun@1.4.2",
    "license": "UNLICENSED",
    "author": "propagande.studio",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/propagande-studio/utils.git"
    },
    "type": "module",
    "scripts": {
        "test": "bun test",
        "test:package": "bun ./scripts/check-package.ts",
        "test:link": "bun run build && bun ./scripts/check-linked-consumer.ts",
        "audit": "bun audit",
        "build": "bun ./build && bun run types",
        "publish:npm": "bun run test && bun run build && bun run test:package && npm publish --ignore-scripts --access public --registry=https://registry.npmjs.org",
        "build:watch": "concurrently --kill-others 'bun ./build.watch' 'bun run types --watch --preserveWatchOutput'",
        "types": "tsc --project tsconfig.types.json"
    },
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "concurrently": "^9.2.4",
        "gsap": "3.15.0",
        "typescript": "^5.9.3",
        "vue": "3.5.42"
    },
    "peerDependencies": {
        "gsap": "^3.15.0",
        "vue": "^3.5.42"
    },
    "overrides": {
        "shell-quote": "^1.11.0"
    },
    "files": [
        "dist",
        "packages"
    ],
    "main": "./dist/shared-index.js",
    "module": "./dist/shared-index.js",
    "types": "./dist/shared/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/shared/index.d.ts",
            "import": "./dist/shared-index.js",
            "default": "./dist/shared-index.js"
        },
        "./shared": {
            "types": "./dist/shared/index.d.ts",
            "import": "./dist/shared-index.js",
            "default": "./dist/shared-index.js"
        },
        "./voir": {
            "types": "./dist/voir/index.d.ts",
            "import": "./dist/voir-index.js",
            "default": "./dist/voir-index.js"
        },
        "./gsap": {
            "types": "./dist/gsap/index.d.ts",
            "import": "./dist/gsap-index.js",
            "default": "./dist/gsap-index.js"
        }
    }
}
