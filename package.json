{
    "name": "@propagande-studio/utils",
    "version": "0.0.6-fix.2",
    "description": "PROPAGANDE utils.",
    "author": "propagande.studio",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/propagande-studio/utils.git"
    },
    "type": "module",
    "scripts": {
        "build": "bun ./build && bun run types",
        "build:watch": "concurrently --kill-others \"bun ./build.watch\" \"bun run types --watch --preserveWatchOutput\"",
        "types": "tsc --project tsconfig.types.json"
    },
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@types/bun": "latest",
        "concurrently": "^9.1.2"
    },
    "peerDependencies": {
        "typescript": "^5",
        "gsap": "^3.12"
    },
    "files": [
        "dist"
    ],
    "main": "./dist/shared-index.js",
    "module": "./dist/shared-index.js",
    "types": "./dist/shared/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/shared/index.d.ts",
            "import": "./dist/shared-index.js",
            "default": "./dist/shared-index.js"
        },
        "./shared": {
            "types": "./dist/shared/index.d.ts",
            "import": "./dist/shared-index.js",
            "default": "./dist/shared-index.js"
        },
        "./voir": {
            "types": "./dist/voir/index.d.ts",
            "import": "./dist/voir-index.js",
            "default": "./dist/voir-index.js"
        }
    }
}
